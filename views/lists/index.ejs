<% layout("layouts/boilerplate") %>

<div class="container-fluid p-0">


    <section class="hero">
        <img src="assets/img1.png" class="hero-img">
    </section>



    <section class="collection-section container-fluid">

        <div class="row gx-4">

            <div class="col-4 collection-left">
                <img src="assets/img2.png" class="collection-img">
            </div>

            <div class="col-4 collection-center">
                <img src="assets/img3.png" class="collection-img">
            </div>

            <div class="col-4 collection-right">
                <img src="assets/img4.png" class="collection-img">
            </div>

        </div>

    </section>



    <section class="product-showcase">

    <div class="product-image">
        <img src="assets/img5.png" alt="Undo products">
    </div>

    <div class="product-text text-left">
        <h6>Niacinamide</h6>
        <p>
            Helps balance excess oil and<br>
            the look of pores while supporting<br>
            smoother-looking skin.
        </p>
    </div>

    <div class="product-text text-right">
        <h6>Hyaluronic Acid</h6>
        <p>
            Helps restore hydration and<br>
            leaves skin feeling soft,<br>
            fresh and comfortable.
        </p>
    </div>

    <div class="product-text text-right-bottom">
        <h6>Centella Asiatica</h6>
        <p>
            Works to help soothe and support the skin barrier<br>
            during cleaning, helping reduce feelings of dryness<br>
            and sensitivity after use.
        </p>
    </div>

    </section>



    <section class="last-section">
        <img src="assets/img6.png">
    </section>


    
    <section class="last-section">
        <img src="assets/img7.png">
    </section>

</div>