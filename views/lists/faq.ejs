<% layout("layouts/boilerplate") %>

<div class="faq-page">

    <!-- FAQ HERO -->
    <section class="faq-hero">
        <div class="faq-hero-content">
            <p class="faq-eyebrow">UNDO / INFORMATION</p>

            <h1>Frequently<br>Asked Questions</h1>

            <p class="faq-intro">
                Everything you need to know about our products,
                ingredients, orders and skincare.
            </p>
        </div>
    </section>


    <!-- FAQ SECTION -->
    <section class="faq-section">

        <div class="faq-heading">
            <p class="faq-small-title">HAVE QUESTIONS?</p>

            <h2>
                Find your<br>
                answers.
            </h2>
        </div>


        <div class="faq-list">

            <!-- FAQ 1 -->
            <div class="faq-item">

                <button class="faq-question" type="button">
                    <span>What skin types are your products suitable for?</span>

                    <span class="faq-icon">
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="faq-answer">
                    <p>
                        Our products are designed with gentle,
                        skin-supporting ingredients and can be suitable
                        for a wide range of skin types. However, everyone's
                        skin is different, so we recommend checking the
                        ingredients before use.
                    </p>
                </div>

            </div>


            <!-- FAQ 2 -->
            <div class="faq-item">

                <button class="faq-question" type="button">
                    <span>How should I use the products?</span>

                    <span class="faq-icon">
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="faq-answer">
                    <p>
                        Apply the product to clean skin as directed.
                        Start with a small amount and gently massage
                        it into the skin. Follow with the rest of your
                        skincare routine.
                    </p>
                </div>

            </div>


            <!-- FAQ 3 -->
            <div class="faq-item">

                <button class="faq-question" type="button">
                    <span>Can I use the products every day?</span>

                    <span class="faq-icon">
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="faq-answer">
                    <p>
                        Most of our products can be incorporated into
                        a regular skincare routine. If you are introducing
                        a new active ingredient, we recommend starting
                        gradually and seeing how your skin responds.
                    </p>
                </div>

            </div>


            <!-- FAQ 4 -->
            <div class="faq-item">

                <button class="faq-question" type="button">
                    <span>Are your products suitable for sensitive skin?</span>

                    <span class="faq-icon">
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="faq-answer">
                    <p>
                        Our formulas focus on skin-friendly ingredients,
                        but sensitive skin can react differently to
                        individual ingredients. We recommend performing
                        a patch test before applying a new product fully.
                    </p>
                </div>

            </div>


            <!-- FAQ 5 -->
            <div class="faq-item">

                <button class="faq-question" type="button">
                    <span>How long does delivery take?</span>

                    <span class="faq-icon">
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="faq-answer">
                    <p>
                        Orders are generally processed within a few
                        business days. Delivery time may vary depending
                        on your location and the shipping method selected
                        at checkout.
                    </p>
                </div>

            </div>


            <!-- FAQ 6 -->
            <div class="faq-item">

                <button class="faq-question" type="button">
                    <span>Can I return or exchange my order?</span>

                    <span class="faq-icon">
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="faq-answer">
                    <p>
                        If you receive a damaged or incorrect product,
                        please contact us as soon as possible with your
                        order details. Our team will help you with the
                        next steps.
                    </p>
                </div>

            </div>


            <!-- FAQ 7 -->
            <div class="faq-item">

                <button class="faq-question" type="button">
                    <span>How should I store my skincare products?</span>

                    <span class="faq-icon">
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="faq-answer">
                    <p>
                        Keep your products in a cool, dry place away
                        from direct sunlight. Always close the packaging
                        properly after use.
                    </p>
                </div>

            </div>


            <!-- FAQ 8 -->
            <div class="faq-item">

                <button class="faq-question" type="button">
                    <span>Where can I contact you if I have more questions?</span>

                    <span class="faq-icon">
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div class="faq-answer">
                    <p>
                        You can reach out to us through our contact page.
                        Our team will be happy to help you with any
                        questions about our products or your order.
                    </p>
                </div>

            </div>

        </div>

    </section>


    <!-- CONTACT CTA -->
    <section class="faq-contact">

        <p class="faq-small-title">STILL CURIOUS?</p>

        <h2>Let's talk.</h2>

        <p>
            Can't find what you're looking for?
            We're always happy to help.
        </p>

        <a href="/contact" class="faq-contact-btn">
            CONTACT US
            <span>↗</span>
        </a>

    </section>

</div>


<script src="/js/faq.js"></script>