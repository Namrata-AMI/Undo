<%- layout("layouts/boilerplate.ejs") %>

<section class="undo-about">

    <!-- =================================================
         01 — HERO
    ================================================== -->

    <section class="about-hero">

        <div class="about-hero-content">

            <span class="about-eyebrow">
                01 / ABOUT UNDO
            </span>

            <h1>
                Skincare,
                <em>made simpler.</em>
            </h1>

            <p class="about-hero-text">
                UNDO was created with one simple idea —
                skincare does not need to be complicated.
                We create thoughtful essentials designed
                to fit naturally into everyday life.
            </p>

        </div>


        <div class="about-hero-image">

            <img
                src="/assets/img11.png"
                alt="UNDO skincare"
            >

        </div>

    </section>



    <!-- =================================================
         02 — WHAT WE MAKE
    ================================================== -->

    <section class="about-products">

        <div class="about-section-intro">

            <span class="about-eyebrow">
                02 / WHAT WE MAKE
            </span>

            <h2>
                Essentials for
                <em>everyday skin.</em>
            </h2>

        </div>


        <div class="about-products-list">

            <div class="about-product-row">

                <span>01</span>

                <h3>Cleansers</h3>

                <p>
                    Gentle everyday formulas designed
                    to leave skin feeling clean, fresh
                    and comfortable.
                </p>

            </div>


            <div class="about-product-row">

                <span>02</span>

                <h3>Serums</h3>

                <p>
                    Focused formulas created to support
                    the skin with simple and purposeful care.
                </p>

            </div>


            <div class="about-product-row">

                <span>03</span>

                <h3>Moisturisers</h3>

                <p>
                    Lightweight hydration made for
                    comfortable everyday use.
                </p>

            </div>


            <div class="about-product-row">

                <span>04</span>

                <h3>Treatments</h3>

                <p>
                    Carefully considered products for
                    specific skincare needs.
                </p>

            </div>

        </div>

    </section>



    <!-- =================================================
         03 — PHILOSOPHY
    ================================================== -->

    <section class="about-philosophy">

        <span class="about-eyebrow">
            03 / OUR PHILOSOPHY
        </span>

        <h2>
            Less noise.
            <em>More skin.</em>
        </h2>

        <p>
            We believe skincare should feel simple,
            honest and intentional. Instead of adding
            more steps, we focus on creating products
            that have a clear purpose and a place in
            your everyday routine.
        </p>

    </section>



    <!-- =================================================
         04 — OUR JOURNEY
    ================================================== -->

    <section class="about-journey">

        <div class="about-journey-heading">

            <span class="about-eyebrow">
                04 / OUR JOURNEY
            </span>

            <h2>
                From a simple idea
                <em>to something real.</em>
            </h2>

        </div>


        <div class="about-timeline">

            <div class="about-timeline-row">

                <span class="about-timeline-year">
                    2022
                </span>

                <h3>The Beginning</h3>

                <p>
                    UNDO begins with a simple idea:
                    make skincare easier to understand
                    and easier to use.
                </p>

            </div>


            <div class="about-timeline-row">

                <span class="about-timeline-year">
                    2023
                </span>

                <h3>First Collection</h3>

                <p>
                    Our first collection brings together
                    everyday skincare essentials built
                    around simplicity.
                </p>

            </div>


            <div class="about-timeline-row">

                <span class="about-timeline-year">
                    2024
                </span>

                <h3>Growing Together</h3>

                <p>
                    More people discover UNDO and our
                    small collection continues to grow
                    through trust and word of mouth.
                </p>

            </div>


            <div class="about-timeline-row">

                <span class="about-timeline-year">
                    2025
                </span>

                <h3>A New Chapter</h3>

                <p>
                    We continue developing thoughtful
                    products while staying true to
                    the idea that started it all.
                </p>

            </div>

        </div>

    </section>



    <!-- =================================================
         05 — WHY UNDO
    ================================================== -->

    <section class="about-values">

        <div class="about-values-heading">

            <span class="about-eyebrow">
                05 / WHY UNDO
            </span>

            <h2>
                Thoughtful by
                <em>design.</em>
            </h2>

        </div>


        <div class="about-values-grid">

            <div class="about-value">

                <span class="about-value-number">
                    01
                </span>

                <h3>Simple formulas</h3>

                <p>
                    We keep our approach clear and
                    focused, without unnecessary complexity.
                </p>

            </div>


            <div class="about-value">

                <span class="about-value-number">
                    02
                </span>

                <h3>Thoughtful care</h3>

                <p>
                    Every product is created with purpose,
                    from its formula to the experience.
                </p>

            </div>


            <div class="about-value">

                <span class="about-value-number">
                    03
                </span>

                <h3>Everyday essentials</h3>

                <p>
                    Products made to become a natural
                    part of your everyday routine.
                </p>

            </div>

        </div>

    </section>



    <!-- =================================================
         06 — SUCCESS
    ================================================== -->

    <section class="about-numbers">

        <div class="about-numbers-heading">

            <span class="about-eyebrow">
                06 / UNDO TODAY
            </span>

            <h2>
                Small beginnings.
                <em>Big trust.</em>
            </h2>

        </div>


        <div class="about-number-grid">

            <div class="about-number-item">

                <strong>10K+</strong>

                <span>
                    Happy customers
                </span>

            </div>


            <div class="about-number-item">

                <strong>25+</strong>

                <span>
                    Products created
                </span>

            </div>


            <div class="about-number-item">

                <strong>4.9/5</strong>

                <span>
                    Customer rating
                </span>

            </div>

        </div>

    </section>



    <!-- =================================================
         FINAL
    ================================================== -->

    <section class="about-final">

        <span class="about-eyebrow">
            THE UNDO WAY
        </span>

        <h2>
            Skincare,
            <em>undone.</em>
        </h2>

        <p>
            Simple products. Thoughtful care.
            Nothing more than your skin needs.
        </p>

    </section>

</section>